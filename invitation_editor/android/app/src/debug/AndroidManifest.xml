<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Required so the Flutter tool can talk to the running app over the
      local network during `flutter run` (hot reload / debugger). Debug
      builds only — never present in release, keeping the shipped app
      fully offline.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
