<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app ships a light "Warm Ivory & Gold" theme by default (a
         "Warm Dark" option is listed for Settings in the UI/UX spec),
         so the launch screen stays ivory in dark mode too rather than
         flashing a colour the app never uses. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
